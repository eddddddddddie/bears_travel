// Worker config for bears.thisaithat.com, deployed by Cloudflare Workers Builds from main.
// site/ is served as static assets; /api/* runs worker/index.js (Bear-ai).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bears-travel",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Bear-ai's daily question counters. Until this binding exists Bear-ai reports itself off and
  // the page shows no button. Secrets (ANTHROPIC_API_KEY, TURNSTILE_*) are set in the dashboard.
  "kv_namespaces": [],
  "observability": { "enabled": true }
}
